{% liquid
  assign stats    = data.listening_stats
  assign sessions = data.listening_sessions.sessions
  assign books    = data.items_in_progress.libraryItems

  assign server     = trmnl.plugin_settings.custom_fields_values.server
  assign auth_token = data.me.token

  assign current_book = nil
  for book in books
    unless book.userMediaProgress.hideFromContinueListening
      assign current_book = book
      break
    endunless
  endfor

  if current_book
    assign recent_itemid = current_book.id
    assign book_title    = current_book.media.metadata.title       | default: "—"
    assign book_author   = current_book.media.metadata.authorName  | default: "—"
    assign book_pos      = current_book.userMediaProgress.currentTime | default: 0
    assign book_dur      = current_book.media.duration              | default: 1
  else
    assign recent_itemid = ""
    assign book_title    = "—"
    assign book_author   = "—"
    assign book_pos      = 0
    assign book_dur      = 1
  endif

  assign cover_url    = server | append: "/api/items/" | append: recent_itemid | append: "/cover?token=" | append: auth_token
  assign book_pct     = book_pos | times: 100.0 | divided_by: book_dur | round: 1
  assign book_pct_bar = book_pct | round: 0

  assign book_dur_h = book_dur | divided_by: 3600 | floor
  assign book_dur_m = book_dur | modulo: 3600 | divided_by: 60 | floor
  assign book_pos_h = book_pos | divided_by: 3600 | floor
  assign book_pos_m = book_pos | modulo: 3600 | divided_by: 60 | floor

  assign items_finished = stats.numItemsFinished | default: 0

  assign days_listened = 0
  for day in stats.days
    if day[1] > 0
      assign days_listened = days_listened | plus: 1
    endif
  endfor

  assign week_sec = 0
  assign best_sec = 0
  for day in stats.days
    assign week_sec = week_sec | plus: day[1]
    if day[1] > best_sec
      assign best_sec = day[1]
    endif
  endfor

  assign week_h        = week_sec | divided_by: 3600
  assign week_m        = week_sec | modulo: 3600 | divided_by: 60
  assign week_min      = week_sec | divided_by: 60
  assign best_min      = best_sec | divided_by: 60
  assign daily_avg_min = week_sec | divided_by: 7 | divided_by: 60

  assign today_sec = stats.today | default: 0
  assign today_h   = today_sec | divided_by: 3600
  assign today_m   = today_sec | modulo: 3600 | divided_by: 60

  assign streak    = 0
  assign prev_date = nil
  for session in sessions
    if forloop.first
      assign streak    = 1
      assign prev_date = session.date
    else
      if session.date != prev_date
        assign prev_date = session.date
        assign streak    = streak | plus: 1
      endif
    endif
    if streak >= 7
      break
    endif
  endfor

  if stats.today > 0
    assign now_listening = true
  else
    assign now_listening = false
  endif

  assign abs_chart_id = "abs-chart" | append_random
  assign abs_heatmap_id = "abs-heatmap" | append_random
  assign abs_heatmap_months_id = "abs-heatmap-months" | append_random
  assign abs_heatmap_days_id = "abs-heatmap-days" | append_random

%}


{% template title_bar %}
<div class="title_bar">
  <span class="title">🎧 Audiobookshelf</span>
  <span class="instance">{{ data.me.username | escape }}</span>
</div>
{% endtemplate %}

<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>
<script type="text/javascript">
(function() {
  function init() {
  var days = [
    {% for day in stats.days %}
    {
      name: {{ day[0] | date: "%a" | json }},
      y: {{ day[1] | divided_by: 60.0 | round: 1 }},
      isToday: {% if forloop.last %}true{% else %}false{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  var chartEl = document.getElementById('{{ abs_chart_id }}');
  if (chartEl && !chartEl.dataset.hcInit) {
    chartEl.dataset.hcInit = '1';
  } else { chartEl = null; }
  var absChart = chartEl && Highcharts.chart('{{ abs_chart_id }}', {
    chart: {
      type: 'column',
      height: {% if view == 1 %}150{% else %}110{% endif %},
      width: null,
      animation: false,
      spacing: [5, 5, 5, 5]
    },
    title: { text: null },
    credits: { enabled: false },
    legend: { enabled: false },
    tooltip: { enabled: false },
    plotOptions: {
      series: {
        animation: false,
        enableMouseTracking: false,
        states: { hover: { enabled: false } },
        borderWidth: 0,
        pointPadding: 0.05,
        groupPadding: 0.1,
        dataLabels: {
          enabled: true,
          formatter: function() {
            if (this.y < 1) return '';
            var h = Math.floor(this.y / 60);
            var m = Math.round(this.y % 60);
            return h > 0 ? h + 'h' : m + 'm';
          },
          style: { fontSize: '12px', fontWeight: 'bold', textOutline: 'none', color: '#000000' }
        }
      }
    },
    xAxis: {
      type: 'category',
      categories: days.map(function(d) { return d.name; }),
      lineWidth: 0,
      gridLineDashStyle: 'dot',
      gridLineWidth: 1,
      gridLineColor: '#000000',
      tickWidth: 0,
      tickLength: 0,
      labels: { style: { fontSize: '14px', color: '#000000' } }
    },
    yAxis: {
      title: { text: null },
      gridLineDashStyle: 'shortdot',
      gridLineWidth: 1,
      gridLineColor: '#000000',
      tickAmount: 4,
      labels: {
        formatter: function() {
          if (this.value < 60) return this.value + 'm';
          return Math.floor(this.value / 60) + 'h';
        },
        style: { fontSize: '13px', color: '#000000' }
      }
    },
    series: [{
      data: days.map(function(d) {
        return {
          y: d.y,
          color: d.isToday
            ? { pattern: { image: 'https://trmnl.com/images/grayscale/gray-3.png', width: 12, height: 12 } }
            : '#000000'
        };
      })
    }]
  });
  setTimeout(function() { absChart && absChart.reflow(); }, 50);

  // Heatmap
  (function() {
    var daysData = {{ stats.days | json }};
    var CELL  = 10;
    var GAP   = 1;
    var STEP  = CELL + GAP;
    var WEEKS = 52;
    var DAYS  = 7;
    var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    var container = document.getElementById('{{ abs_heatmap_id }}');
    if (!container) return;

    // CSS grid layout — no absolute positioning, no overflow issues
    container.style.display           = 'grid';
    container.style.gridTemplateRows  = 'repeat(' + DAYS + ', ' + CELL + 'px)';
    container.style.gridAutoColumns   = CELL + 'px';
    container.style.gridAutoFlow      = 'column';
    container.style.gap               = GAP + 'px';
    container.style.width             = 'fit-content';

    var maxSec = 1;
    Object.keys(daysData || {}).forEach(function(k) {
      if (daysData[k] > maxSec) maxSec = daysData[k];
    });

    var today    = new Date();
    var todayDow = (today.getDay() + 6) % 7; // 0=Mon … 6=Sun
    var monthLabels = {};
    var prevMonth   = -1;

    for (var w = 0; w < WEEKS; w++) {
      for (var d = 0; d < DAYS; d++) {
        var daysAgo = (WEEKS - 1 - w) * 7 + (todayDow - d);
        var dt = new Date(today);
        dt.setDate(dt.getDate() - daysAgo);
        var dateStr = dt.getFullYear() + '-'
          + String(dt.getMonth() + 1).padStart(2, '0') + '-'
          + String(dt.getDate()).padStart(2, '0');

        var sec       = (daysData && daysData[dateStr]) ? daysData[dateStr] : 0;
        var intensity = sec > 0 ? sec / maxSec : 0;

        var cell = document.createElement('div');
        cell.style.borderRadius = '1px';

        if (daysAgo < 0) {
          cell.style.backgroundColor = 'transparent';
        } else if (sec === 0) {
          cell.style.backgroundColor = '#d8d8d8';
        } else if (intensity < 0.25) {
          cell.style.backgroundColor = '#909090';
        } else if (intensity < 0.5) {
          cell.style.backgroundColor = '#585858';
        } else if (intensity < 0.75) {
          cell.style.backgroundColor = '#2c2c2c';
        } else {
          cell.style.backgroundColor = '#000000';
        }

        container.appendChild(cell);

        if (d === 0) {
          var m = dt.getMonth();
          if (m !== prevMonth) {
            prevMonth = m;
            monthLabels[w] = MONTHS[m];
          }
        }
      }
    }

    var gridH = DAYS * STEP - GAP;

    // Month labels
    var mContainer = document.getElementById('{{ abs_heatmap_months_id }}');
    if (mContainer) {
      Object.keys(monthLabels).forEach(function(w) {
        var lbl = document.createElement('span');
        lbl.textContent      = monthLabels[w];
        lbl.style.position   = 'absolute';
        lbl.style.left       = (w * STEP) + 'px';
        lbl.style.fontSize   = '9px';
        lbl.style.lineHeight = '12px';
        lbl.style.color      = '#444';
        mContainer.appendChild(lbl);
      });
    }

    // Day labels (M / W / F)
    var dContainer = document.getElementById('{{ abs_heatmap_days_id }}');
    if (dContainer) {
      dContainer.style.height = gridH + 'px';
      [{d:1,label:'M'},{d:3,label:'W'},{d:5,label:'F'}].forEach(function(item) {
        var lbl = document.createElement('span');
        lbl.textContent      = item.label;
        lbl.style.position   = 'absolute';
        lbl.style.top        = (item.d * STEP) + 'px';
        lbl.style.fontSize   = '9px';
        lbl.style.lineHeight = CELL + 'px';
        lbl.style.color      = '#444';
        dContainer.appendChild(lbl);
      });
    }

    container.style.height = gridH + 'px';
  })();
  } // init
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
