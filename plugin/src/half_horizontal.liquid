  <div class="layout layout--row gap--none">

    <div class="flex flex--col gap--small p--4" style="width:40%; flex-shrink:0;">
      <div style="height:35cqh; overflow:hidden; flex-shrink:0;">
        <img src="{{ cover_url }}" class="image image-dither image--cover w--full h--full" />
      </div>
      <span class="title title--small" data-clamp="2">{{ book_title }}</span>
      <span class="description">{{ book_author }}</span>
      <div class="progress-bar progress-bar--small">
        <div class="content" style="justify-content:space-between;">
          <span class="label label--small">{{ book_pos_h }}h {{ book_pos_m }}m / {{ book_dur_h }}h {{ book_dur_m }}m</span>
          <span class="value value--xxsmall">{{ book_pct }}%</span>
        </div>
        <div class="track">
          <div class="fill" style="width:{{ book_pct_bar }}%"></div>
        </div>
      </div>
    </div>

    <div class="divider--v"></div>

    <div class="flex flex--col gap p--4" style="flex:1; min-width:0;">
      <div class="grid grid--cols-3 {{ stats_classes }}">
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large value--tnums">{{ items_finished }}</span>
            <span class="label label--small">Finished</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--tnums">{{ week_min }}</span>
            <span class="label label--small">Min/Week</span>
          </div>
        </div>
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--tnums">{{ streak }}</span>
            <span class="label label--small">Day Streak</span>
          </div>
        </div>
      </div>
      <div class="divider"></div>
      <div class="flex flex--col gap--small {{ chart_classes }}" style="flex:1; min-width:0;">
        <span class="label">Last 7 Days</span>
        <div id="abs-chart" style="flex:1; overflow:hidden; width:100%;"></div>
      </div>
    </div>

  </div>
{% render "title_bar", data: data %}