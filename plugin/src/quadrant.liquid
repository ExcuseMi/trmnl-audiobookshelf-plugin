  <div class="layout layout--col gap p--4">
    <div class="flex flex--row gap">
      <div style="width:3rem; flex-shrink:0;">
        <img src="{{ cover_url }}" class="image image-dither image--cover w--full" style="height:4rem;" />
      </div>
      <div class="flex flex--col gap--none" style="min-width:0;">
        <span class="title title--small" data-clamp="1">{{ book_title }}</span>
        <span class="description">{{ book_author }}</span>
        <div class="progress-bar progress-bar--small">
          <div class="track">
            <div class="fill" style="width:{{ book_pct_bar }}%"></div>
          </div>
        </div>
        <span class="label label--small">{{ book_pct }}% complete</span>
      </div>
    </div>
    <div class="divider"></div>
    <div class="grid grid--cols-3 {{ stats_classes }}">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large value--tnums">{{ today_h }}h {{ today_m }}m</span>
          <span class="label label--small">Today</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large value--tnums">{{ week_min }}</span>
          <span class="label label--small">Min/Week</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large value--tnums">{{ streak }}</span>
          <span class="label label--small">Streak</span>
        </div>
      </div>
    </div>
  </div>
{% render "title_bar", data: data %}